 package io.freemytv;
 
 import android.accessibilityservice.AccessibilityService;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.SystemClock;
 import android.view.KeyEvent;
 import android.view.accessibility.AccessibilityEvent;
 
 /**
  * Sees the remote's keys before any app does, so the app buttons work from inside Netflix, Disney and the rest. The
  * system waits for it on every key (up to half a second), so it runs in a process of its own and does next to nothing.
+ * On RemoteKeys.HOME_KEY TVs it also hears the TV start and wake, for Google TV's account picker.
  */
 public class RemoteKeyService extends AccessibilityService {
+    private final BroadcastReceiver screenOn = new BroadcastReceiver() {
+        @Override public void onReceive(Context c, Intent i) {
+            RemoteKeys.onTvOn(RemoteKeyService.this);
+        }
+    };
+    private boolean listening;
+
+    @Override protected void onServiceConnected() {
+        super.onServiceConnected();
+        if (!RemoteKeys.HOME_KEY) return;
+        registerReceiver(screenOn, new IntentFilter(Intent.ACTION_SCREEN_ON));
+        listening = true;
+        // Connected in the first minutes after boot: the TV just started (not an app update or a mode switch).
+        if (SystemClock.elapsedRealtime() < 3 * 60_000) RemoteKeys.onTvOn(this);
+    }
+
+    @Override public void onDestroy() {
+        if (listening) unregisterReceiver(screenOn);
+        super.onDestroy();
+    }
+
     @Override protected boolean onKeyEvent(KeyEvent event) {
         return RemoteKeys.onKey(this, event);
     }
 
-    @Override public void onAccessibilityEvent(AccessibilityEvent event) {}
+    @Override public void onAccessibilityEvent(AccessibilityEvent event) {
+        RemoteKeys.onWindow(this, event);
+        RemoteKeys.onAccount(this, event);
+    }
 
     @Override public void onInterrupt() {}
 }
