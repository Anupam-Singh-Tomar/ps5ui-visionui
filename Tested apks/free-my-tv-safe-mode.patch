@@ -0,0 +1,36 @@
+package io.freemytv;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Build;
+
+/**
+ * Requests from ps5UI (io.freemytv.cinema, its account corner): Free Memory, answered with the result. Only ps5UI may
+ * ask (Android 14 says who sent a broadcast when the sender shares it, as ps5UI does). Runs in the :keys process,
+ * where the Control Center's Free Memory runs too, so `am kill-all` never takes it down halfway.
+ */
+public class RequestReceiver extends BroadcastReceiver {
+    static final String FREE_MEMORY = "io.freemytv.FREE_MEMORY";
+
+    @Override public void onReceive(Context context, Intent intent) {
+        if (!FREE_MEMORY.equals(intent.getAction())) return;
+        if (Build.VERSION.SDK_INT >= 34 && !RemoteKeys.CINEMA.equals(getSentFromPackage())) {
+            AppLog.w("free memory asked by " + getSentFromPackage() + ": ignored");
+            return;
+        }
+        PendingResult result = goAsync();
+        boolean started = MemoryCleaner.clean(context, text -> {
+            answer(context, text);
+            result.finish();
+        });
+        if (!started) {
+            answer(context, "");   // one is already running: ps5UI says so
+            result.finish();
+        }
+    }
+
+    private static void answer(Context c, String text) {
+        c.sendBroadcast(new Intent(RemoteKeys.CINEMA + ".FREED").setPackage(RemoteKeys.CINEMA).putExtra("text", text));
+    }
+}
