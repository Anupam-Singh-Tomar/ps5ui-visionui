<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.freemytv.cinema">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- TVmaze's streaming schedule and the posters; and the TV's own ADB (127.0.0.1:5555), for the Home button's
         setup and Free memory -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: the apps in the dock and the streaming apps the cards open -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The Inputs row: the TV's inputs and the apps that show them -->
        <intent>
            <action android:name="android.media.tv.TvInputService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
        <intent>
            <action android:name="com.android.tv.action.VIEW_INPUTS" />
        </intent>
        <package android:name="com.android.tv.settings" />
        <!-- Switch account and the picker on waking: Google TV's own account picker -->
        <package android:name="com.google.android.apps.tv.launcherx" />
        <!-- The Home button: the TV's own home screen, the one it replaces -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:label="ps5UI"
        android:theme="@style/Cinema">

        <activity
            android:name=".CinemaActivity"
            android:label="ps5UI"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- For ps5UI's corner: the account chosen on Google TV's picker, from the Home button or Free My TV's -->
        <receiver
            android:name=".CornerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.freemytv.cinema.ACCOUNT" />
            </intent-filter>
        </receiver>

        <!-- Home settings: which home screen the Home button opens -->
        <activity
            android:name=".HomeSetup"
            android:label="Home button"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- The Home button (Free My TV's safe mode, built in). Its own process: the system waits for it on every key,
             so the home screens must never be able to slow it down, and it stays small while another app is open. -->
        <service
            android:name=".KeyService"
            android:process=":keys"
            android:exported="true"
            android:label="ps5UI Home button"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

        <!-- visionUI: the same shows and apps as a glass window, in visionOS's manner -->
        <activity
            android:name=".VisionActivity"
            android:label="visionUI"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:taskAffinity="io.freemytv.cinema.vision">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
