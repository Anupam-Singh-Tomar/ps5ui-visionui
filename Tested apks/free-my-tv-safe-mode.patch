@@ -0,0 +1,132 @@
+package io.freemytv;
+
+import android.accessibilityservice.AccessibilityService;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.PixelFormat;
+import android.graphics.drawable.BitmapDrawable;
+import android.graphics.drawable.GradientDrawable;
+import android.provider.Settings;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.KeyEvent;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/**
+ * Holding Home (RemoteKeys.HOME_KEY TVs): a panel over whatever is on screen, with Free Memory, the Sleep Timer and the
+ * TV's picture, sound and input screens. Drawn by RemoteKeyService as an accessibility overlay (no permission to ask),
+ * in the :keys process, with plain views; Back or Home closes it.
+ */
+final class ControlCenter {
+    private ControlCenter() {}
+
+    private static LinearLayout panel;
+    private static TextView memoryRow;
+
+    static boolean showing() {
+        return panel != null;
+    }
+
+    static void show(AccessibilityService s) {
+        if (panel != null) return;
+        Ui.init(s);   // this process doesn't load the fonts and the language until it needs them
+        float k = s.getResources().getDisplayMetrics().widthPixels / 1920f;
+        panel = new LinearLayout(s) {
+            @Override public boolean dispatchKeyEvent(KeyEvent e) {
+                if (e.getKeyCode() != KeyEvent.KEYCODE_BACK) return super.dispatchKeyEvent(e);
+                if (e.getAction() == KeyEvent.ACTION_UP) hide(s);
+                return true;
+            }
+        };
+        panel.setOrientation(LinearLayout.VERTICAL);
+        int pad = Math.round(28 * k);
+        panel.setPadding(pad, pad, pad, pad);
+        GradientDrawable glass = new GradientDrawable();
+        glass.setColor(0xE61C1C1E);
+        glass.setCornerRadius(36 * k);
+        panel.setBackground(glass);
+
+        TextView title = text(s, Ui.tr("Control Center"), 30 * k, k);
+        title.setPadding(Math.round(20 * k), 0, 0, Math.round(16 * k));
+        panel.addView(title);
+        memoryRow = row(s, k, "sparkles", Ui.tr("Free Memory"), v -> {
+            memoryRow.setText(Ui.tr("Freeing memory…"));
+            MemoryCleaner.clean(s, text -> {
+                if (memoryRow != null) memoryRow.setText(text);
+            });
+        });
+        row(s, k, "home", Ui.tr("Switch Account"), v -> {
+            hide(s);
+            RemoteKeys.openProfiles(s);
+        });
+        row(s, k, "bedtime", Ui.tr("Sleep Timer"), v -> open(s, new Intent().setClassName(HomeMode.PKG,
+                HomeMode.PKG + ".SettingsActivity").putExtra("sleep", true)));
+        row(s, k, "tv_settings", Ui.tr("Picture"), v -> open(s, new Intent(Settings.ACTION_DISPLAY_SETTINGS)));
+        row(s, k, "speaker", Ui.tr("Sound"), v -> open(s, new Intent(Settings.ACTION_SOUND_SETTINGS)));
+        row(s, k, "hdmi", Ui.tr("Inputs"), v -> open(s, new Intent("com.android.tv.action.VIEW_INPUTS")));
+        row(s, k, "settings", Ui.tr("Home Settings"), v -> open(s, new Intent().setClassName(HomeMode.PKG,
+                HomeMode.PKG + ".SettingsActivity")));
+
+        WindowManager.LayoutParams layout = new WindowManager.LayoutParams(Math.round(560 * k),
+                WindowManager.LayoutParams.WRAP_CONTENT, WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
+                WindowManager.LayoutParams.FLAG_DIM_BEHIND, PixelFormat.TRANSLUCENT);
+        layout.gravity = Gravity.RIGHT | Gravity.CENTER_VERTICAL;
+        layout.x = Math.round(48 * k);
+        layout.dimAmount = 0.35f;
+        s.getSystemService(WindowManager.class).addView(panel, layout);
+        panel.getChildAt(1).requestFocus();
+    }
+
+    static void hide(Context c) {
+        if (panel == null) return;
+        try {
+            c.getSystemService(WindowManager.class).removeView(panel);
+        } catch (IllegalArgumentException ignored) {}   // already gone with its window
+        panel = null;
+        memoryRow = null;
+    }
+
+    private static void open(AccessibilityService s, Intent intent) {
+        hide(s);
+        if (intent.resolveActivity(s.getPackageManager()) == null) return;
+        s.startActivity(intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+    }
+
+    /** One row: a symbol and its name; white with dark ink while focused, like the settings screen. */
+    private static TextView row(Context c, float k, String symbol, String label, View.OnClickListener click) {
+        TextView t = text(c, label, 26 * k, k);
+        t.setPadding(Math.round(20 * k), Math.round(16 * k), Math.round(20 * k), Math.round(16 * k));
+        BitmapDrawable icon = new BitmapDrawable(c.getResources(), Symbols.get(c, symbol));
+        icon.setBounds(0, 0, Math.round(30 * k), Math.round(30 * k));
+        icon.setTint(0xEBFFFFFF);
+        t.setCompoundDrawables(icon, null, null, null);
+        t.setCompoundDrawablePadding(Math.round(18 * k));
+        GradientDrawable bg = new GradientDrawable();
+        bg.setCornerRadius(18 * k);
+        bg.setColor(0x00000000);
+        t.setBackground(bg);
+        t.setFocusable(true);
+        t.setClickable(true);
+        t.setOnClickListener(click);
+        t.setOnFocusChangeListener((v, has) -> {
+            bg.setColor(has ? 0xFFF5F5F7 : 0x00000000);
+            t.setTextColor(has ? 0xFF1D1D1F : 0xEBFFFFFF);
+            icon.setTint(has ? 0xFF1D1D1F : 0xEBFFFFFF);
+        });
+        panel.addView(t);
+        return t;
+    }
+
+    private static TextView text(Context c, String s, float px, float k) {
+        TextView t = new TextView(c);
+        t.setText(s);
+        t.setTypeface(Ui.regular);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_PX, px);
+        t.setTextColor(0xEBFFFFFF);
+        t.setSingleLine(true);
+        return t;
+    }
+}
diff --git a/app/src/io/freemytv/MemoryCleaner.java b/app/src/io/freemytv/MemoryCleaner.java
new file mode 100644
index 0000000..7cbdcff
--- /dev/null
+++ b/app/src/io/freemytv/MemoryCleaner.java
@@ -0,0 +1,61 @@
+package io.freemytv;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+
+import java.io.IOException;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Free Memory (the drawer, the Control Center, and ps5UI's corner through RequestReceiver): closes the apps Android
+ * keeps waiting in the background, through the TV's own ADB (`am kill-all` stops only those it may: nothing on screen,
+ * playing or needed by the system). On a 2 GB TV that gives the next app room before it starts.
+ */
+final class MemoryCleaner {
+    private MemoryCleaner() {}
+
+    interface Done {
+        void done(String text);
+    }
+
+    private static final Pattern AVAILABLE = Pattern.compile("MemAvailable:\\s+(\\d+) kB");
+    private static final AtomicBoolean running = new AtomicBoolean();
+
+    /**
+     * Frees what it can on a background thread; `done` gets the result on the main thread. One at a time: false (and
+     * no `done`) while one is already running.
+     */
+    static boolean clean(Context c, Done done) {
+        if (!running.compareAndSet(false, true)) return false;
+        Context app = c.getApplicationContext();
+        Handler main = new Handler(Looper.getMainLooper());
+        new Thread(() -> {
+            String text;
+            try (Adb adb = Adb.connect(app, 10_000, null)) {
+                long before = available(adb);
+                adb.shell("am kill-all");
+                SystemClock.sleep(1_500);   // the killed processes take a moment to give their memory back
+                long after = available(adb);
+                text = Ui.trf("Freed {freed} MB · {free} MB free", "freed", Math.max(0, after - before), "free", after);
+                AppLog.w("free memory: " + before + " → " + after + " MB");
+            } catch (IOException e) {
+                AppLog.w("free memory: " + e.getMessage());
+                text = Ui.tr("Couldn't free memory: it needs Free My TV mode.");
+            }
+            running.set(false);
+            String result = text;
+            main.post(() -> done.done(result));
+        }, "free-memory").start();
+        return true;
+    }
+
+    /** MemAvailable, in MB. */
+    private static long available(Adb adb) throws IOException {
+        Matcher m = AVAILABLE.matcher(adb.shell("cat /proc/meminfo"));
+        return m.find() ? Long.parseLong(m.group(1)) / 1024 : 0;
+    }
+}
